server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    absolute_redirect off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /index.html {
        # Nginx also enters this location internally when serving '/'.
        if ($request_uri ~ "^/index[.]html") { return 308 /$is_args$args; }
        expires -1;
    }
    location ~ ^/(demo|faq|contact|privacy|terms|cookies|data-deletion|legal)(/|\.html)$ {
        return 308 /$1$is_args$args;
    }

    # English has one canonical URL. Localized pages use extensionless URLs.
    location ~ ^/en(?:/|\.html)?$ { return 308 /$is_args$args; }
    location ~ ^/en/(demo|faq|contact)(?:/|\.html)?$ { return 308 /$1$is_args$args; }
    location ~ ^/(es|de|nb|ru|uk|fr|pl|bg|cs|da|el|et|fi|hr|hu|is|it|lb|lt|lv|mt|nl|nn|pt|rm|ro|sk|sl|sv|ar)(/(demo|faq|contact))?(/|\.html)$ {
        return 308 /$1$2$is_args$args;
    }

    # Old mobile-app URLs must not expose connection/settings screens on web.
    location ~ ^/(settings|flows|connect-guide|terminal|wallet)(\.html)?/?$ {
        return 302 /demo;
    }
    location ~ ^/details(/|$) { return 302 /demo; }
    location = /_sitemap { return 404; }
    location = /_sitemap.html { return 404; }
    location ~ /\. { deny all; }

    # Expo fingerprints these assets. HTML is revalidated on every visit so
    # returning users get the latest deployment instead of a stale entrypoint.
    location /_expo/static/ {
        expires 1y;
        try_files $uri =404;
    }
    location / {
        expires -1;
        # /ru.html must win over the /ru/ directory containing its subpages.
        try_files $uri.html $uri $uri/ =404;
    }
    error_page 404 /+not-found.html;
    location = /+not-found.html {
        internal;
        expires -1;
    }
}
