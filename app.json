{
  "expo": {
    "name": "AirCapital",
    "slug": "AirCapital",
    "version": "2.2.722",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "aircapital",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/branding/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "tim.AirCapital",
      "infoPlist": {},
      "appleTeamId": "QJJFV9YPU3",
      "buildNumber": "9"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#10151F",
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "monochromeImage": "./assets/branding/adaptive-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tim_qiq.AirCapital",
      "icon": "./assets/branding/icon.png",
      "versionCode": 2
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/adaptive-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#10151F"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AirCapital to protect access to your balances."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2821bcd-746c-4c69-a511-6abf03991367"
      }
    }
  }
}
