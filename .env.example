# Public website settings, embedded at build time. Never put secrets here.
# These defaults are also in source. Store pages may return 404 before publication.
EXPO_PUBLIC_SITE_URL=https://aircapital.app
EXPO_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6792837154
EXPO_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=tim.AirCapital
EXPO_PUBLIC_IOS_RELEASED=false
EXPO_PUBLIC_ANDROID_RELEASED=false
EXPO_PUBLIC_CONTACT_EMAIL=timofii.shkabrov@gmail.com
EXPO_PUBLIC_TELEGRAM_URL=

# Enable only after the real store products, RevenueCat credentials and sandbox
# purchase/restore/refund tests are complete. Public SDK keys only; NEVER .p8 or JSON credentials.
EXPO_PUBLIC_SUBSCRIPTIONS_ENABLED=false
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
